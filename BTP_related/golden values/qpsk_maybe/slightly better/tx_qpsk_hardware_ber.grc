    bus_structure: null
    coordinate:
    - 432
    - 228.0
    rotation: 0
    state: enabled
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.basic_block):\n\
      \    \"\"\"BER Frame Generator & Preamble Inserter\"\"\"\n    def __init__(self,\
      \ packet_len=1000):\n        gr.basic_block.__init__(\n            self,\n \
      \           name='BER Frame Generator',\n            in_sig=[np.uint8],\n  \
      \          out_sig=[np.uint8]\n        )\n        self.packet_len = packet_len\n\
      \        # QPSK has 4 symbols (2 bits). Let's use a 32-symbol preamble\n   \
      \     self.preamble = np.array([3, 3, 3, 3, 3, 0, 0, 3, 3, 0, 3, 0, 3, 3, 3,\
      \ 3, 3, 3, 0, 0, 3, 3, 0, 3, 0, 3, 3, 0, 0, 3, 0, 3], dtype=np.uint8)\n    \
      \    np.random.seed(42)\n        self.payload_ref = np.random.randint(0, 4,\
      \ size=968, dtype=np.uint8)\n        self.packet = np.concatenate([self.preamble,\
      \ self.payload_ref])\n        \n        # Pack 2-bit symbols into 8-bit bytes\
      \ (4 symbols per byte)\n        self.packed_packet = np.zeros(len(self.packet)\
      \ // 4, dtype=np.uint8)\n        for i in range(len(self.packed_packet)):\n\
      \            self.packed_packet[i] = (self.packet[4*i] << 6) | (self.packet[4*i+1]\
      \ << 4) | (self.packet[4*i+2] << 2) | self.packet[4*i+3]\n            \n   \
      \     self.ptr = 0\n\n    def general_work(self, input_items, output_items):\n\
      \        in0 = input_items[0]\n        out = output_items[0]\n        n_out\
      \ = len(out)\n        written = 0\n        read = min(len(in0), n_out)\n   \
      \     \n        while written < read:\n            rem = len(self.packed_packet)\
      \ - self.ptr\n            to_write = min(rem, read - written)\n            out[written:written+to_write]\
      \ = self.packed_packet[self.ptr:self.ptr+to_write]\n            self.ptr = (self.ptr\
      \ + to_write) % len(self.packed_packet)\n            written += to_write\n \
      \           \n        self.consume(0, read)\n        return written\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    packet_len: '1000'
  states:
    _io_cache: ('BER Frame Generator', 'blk', [('packet_len', '1000')], [('0', 'byte',
      1)], [('0', 'byte', 1)], 'BER Frame Generator & Preamble Inserter', ['packet_len'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 224
    - 192.0
    rotation: 0
    state: enabled
